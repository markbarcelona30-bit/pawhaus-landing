{
  "name": "pawhaus-hero",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.15.0" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node src/server.mjs",
